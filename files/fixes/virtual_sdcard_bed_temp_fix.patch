+    def get_start_print_bed_temp(self, filename):
+        filepath = os.path.join(base_dir, "printer_data/gcodes", filename)
+        try:
+            with io.open(filepath, "r", encoding="utf-8", errors="ignore") as f:
+                for _ in range(2000):
+                    line = f.readline()
+                    if not line:
+                        break
+                    if "START_PRINT" not in line or "BED_TEMP" not in line:
+                        continue
+                    match = re.search(r"\bBED_TEMP\s*=\s*([0-9]+(?:\.[0-9]+)?)", line)
+                    if match:
+                        return float(match.group(1))
+        except Exception as err:
+            logging.error("get_start_print_bed_temp: %s" % err)
+        return None
 

+    def update_defaults_from_start_print(self, line):
+        stripped = line.lstrip()
+        if not stripped.startswith("START_PRINT"):
+            return
+        match = re.search(r"\bEXTRUDER_TEMP\s*=\s*([0-9]+(?:\.[0-9]+)?)", stripped)
+        if not match:
+            return
+        try:
+            extruder_temp = float(match.group(1))
+        except ValueError:
+            return
+        custom_macro = self.printer.lookup_object('custom_macro', None)
+        if custom_macro:
+            # Keep fallback temperature in sync when box metadata is missing.
+            custom_macro.default_extruder_temp = extruder_temp
+        box = self.printer.lookup_object("box", None)
+        if box and getattr(box, "box_action", None) and getattr(box.box_action, "boxcfg", None):
+            boxcfg = box.box_action.boxcfg
+            if hasattr(boxcfg, "Tn_extrude_temp"):
+                boxcfg.Tn_extrude_temp = extruder_temp
+            elif hasattr(boxcfg, "tn_extrude_temp"):
+                boxcfg.tn_extrude_temp = extruder_temp
 

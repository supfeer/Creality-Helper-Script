+    def get_skip_creality_calibration(self, filename):
+        filepath = filename if os.path.exists(filename) else os.path.join(base_dir, "printer_data/gcodes", filename)
+        skip = None
+        try:
+            with io.open(filepath, "r", encoding="utf-8", errors="ignore") as f:
+                for _ in range(5000):
+                    line = f.readline()
+                    if not line:
+                        break
+                    if "SKIP_CREALITY_CALIBRATION" not in line:
+                        continue
+                    match = re.search(r"\bSKIP_CREALITY_CALIBRATION\s*(?:=\s*([A-Za-z0-9_]+))?", line)
+                    if not match:
+                        continue
+                    value = match.group(1)
+                    if value is None:
+                        skip = True
+                        continue
+                    value = value.strip().strip('"').strip("'").lower()
+                    if value in ("0", "false", "no", "off"):
+                        skip = False
+                    else:
+                        skip = True
+        except Exception as err:
+            logging.error("get_skip_creality_calibration: %s" % err)
+        return bool(skip)
+
